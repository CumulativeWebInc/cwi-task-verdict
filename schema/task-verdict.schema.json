{"$id":"https://cumulativewebinc.github.io/cwi-task-verdict/schema/task-verdict.schema.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"description":"A delegation receipt: the claims a task makes, expressed as evidence-bound checks. The runner executes each check and emits a verdict record.","properties":{"checks":{"items":{"additionalProperties":true,"properties":{"equals":{},"expect":{"type":"integer"},"field":{"type":"string"},"id":{"minLength":1,"type":"string"},"label":{"type":"string"},"min":{"minimum":0,"type":"integer"},"path":{"type":"string"},"pattern":{"type":"string"},"sha256":{"type":"string"},"type":{"enum":["url_status","url_contains","file_exists","file_sha256","file_regex","json_field","count_match"]},"url":{"type":"string"}},"required":["id","type"],"type":"object"},"minItems":1,"type":"array"},"claim":{"description":"the plain-language claim being checked, e.g. 'shipped product #39'","type":"string"},"claimed_by":{"description":"who/what claims the task is done (agent id, human, CI job)","type":"string"},"schema":{"const":"cwi.task-verdict/1.0"},"task_id":{"minLength":1,"type":"string"},"title":{"type":"string"}},"required":["schema","task_id","checks"],"title":"cwi.task-verdict/1.0 — task manifest","type":"object"}