{"$id":"https://cumulativewebinc.github.io/cwi-task-verdict/schema/verdict-record.schema.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"description":"Machine-readable receipt emitted by the Task Verdict runner. PASS proves the listed checks passed at run time — not that the task was 'good'. ERROR means 'could not verify', never 'passed'.","properties":{"checks":{"items":{"properties":{"error":{"type":["string","null"]},"evidence":{"type":["string","null"]},"expected":{},"id":{"type":"string"},"observed":{},"status":{"enum":["PASS","FAIL","ERROR"]},"target":{"type":["string","null"]},"type":{"type":"string"}},"required":["id","type","status"],"type":"object"},"type":"array"},"claimed_by":{"type":["string","null"]},"engine":{"type":"string"},"finished_at":{"type":"string"},"record_id":{"type":"string"},"schema":{"const":"cwi.task-verdict-record/1.0"},"started_at":{"type":"string"},"summary":{"properties":{"error":{"type":"integer"},"fail":{"type":"integer"},"pass":{"type":"integer"},"total":{"type":"integer"}},"required":["pass","fail","error","total"],"type":"object"},"task_id":{"type":"string"},"title":{"type":["string","null"]},"verdict":{"enum":["PASS","FAIL","PARTIAL"]}},"required":["schema","record_id","task_id","verdict","engine","started_at","finished_at","summary","checks"],"title":"cwi.task-verdict-record/1.0 — verdict record","type":"object"}